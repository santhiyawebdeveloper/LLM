# Server environment variables (copy to .env in project root)
SHOPIFY_API_KEY=YOUR_SHOPIFY_API_KEY
SHOPIFY_API_SECRET=YOUR_SHOPIFY_API_SECRET
SHOPIFY_APP_URL=http://localhost:3000
SHOPIFY_SCOPES=read_products
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shopify_lms?retryWrites=true&w=majority
NODE_ENV=development
PORT=3000

# Also set client/.env with:
# VITE_SHOPIFY_API_KEY=<same value as SHOPIFY_API_KEY>
